{
  "name": "@tuck/www-dantuck",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "dev:search": "astro build && pagefind --site dist && astro dev",
    "start": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro",
    "publish-preview": "astro build && pagefind --site dist && wrangler pages deploy dist --project-name=www-dantuck --branch=preview",
    "publish-release": "astro build && pagefind --site dist && wrangler pages deploy dist --project-name=www-dantuck",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "worker:deploy": "wrangler deploy --cwd worker",
    "worker:tail": "wrangler tail dantuck-scheduled-publish",
    "test": "vitest run",
    "test:watch": "vitest",
    "admin:dev": "concurrently \"astro dev --port 4321\" \"wrangler pages dev --proxy 4321 --port 8788\"",
    "admin:dev:local": "astro dev --port 8788",
    "lighthouse": "node scripts/lighthouse.mjs"
  },
  "devDependencies": {
    "@astrojs/mdx": "^8.1.1",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/svelte": "^9.1.1",
    "@cloudflare/workers-types": "^5.20261024.1",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@unocss/astro": "^66.11.0",
    "astro": "^7.4.2",
    "chrome-launcher": "^1.2.2",
    "concurrently": "^10.0.6",
    "lighthouse": "^13.5.0",
    "pagefind": "^1.5.2",
    "playwright": "^1.64.1",
    "satori": "^0.63.2",
    "sharp": "^0.35.5",
    "svelte": "^5.57.2",
    "unocss": "^66.11.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  },
  "dependencies": {
    "@fontsource/opendyslexic": "^5.3.0",
    "@milkdown/core": "^7.22.3",
    "@milkdown/crepe": "^7.22.3",
    "@milkdown/plugin-block": "^7.22.3",
    "@milkdown/plugin-history": "^7.22.3",
    "@milkdown/plugin-listener": "^7.22.3",
    "@milkdown/plugin-slash": "^7.22.3",
    "@milkdown/preset-commonmark": "^7.22.3"
  }
}
